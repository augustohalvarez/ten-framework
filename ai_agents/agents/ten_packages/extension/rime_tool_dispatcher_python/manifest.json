{
  "type": "extension",
  "name": "rime_tool_dispatcher_python",
  "version": "0.1.0",
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11"
    },
    {
      "type": "system",
      "name": "ten_ai_base",
      "version": "0.7"
    }
  ],
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "**.py",
      "README.md"
    ]
  },
  "api": {
    "property": {
      "properties": {
        "provider_extension": {
          "type": "string"
        }
      },
      "required": [
        "provider_extension"
      ]
    },
    "cmd_in": [
      {
        "name": "tool_register",
        "property": {
          "properties": {
            "tool": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {}
                  }
                }
              },
              "required": [
                "name",
                "description",
                "parameters"
              ]
            }
          },
          "required": [
            "tool"
          ]
        },
        "result": {
          "property": {
            "properties": {
              "response": {
                "type": "string"
              }
            }
          }
        }
      }
    ],
    "cmd_out": [
      {
        "name": "tool_call",
        "property": {
          "properties": {
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "object",
              "properties": {}
            }
          },
          "required": [
            "name",
            "arguments"
          ]
        },
        "result": {
          "property": {
            "properties": {
              "tool_result": {
                "type": "object",
                "properties": {}
              }
            }
          }
        }
      }
    ],
    "data_in": [
      {
        "name": "mllm_server_function_call",
        "property": {
          "properties": {
            "call_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "string"
            }
          },
          "required": [
            "call_id",
            "name",
            "arguments"
          ]
        }
      }
    ],
    "data_out": [
      {
        "name": "mllm_client_request_register_tool",
        "property": {
          "properties": {
            "tool": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {}
                  }
                }
              },
              "required": [
                "name",
                "description",
                "parameters"
              ]
            }
          },
          "required": [
            "tool"
          ]
        }
      },
      {
        "name": "mllm_client_function_call_output",
        "property": {
          "properties": {
            "call_id": {
              "type": "string"
            },
            "output": {
              "type": "string"
            }
          },
          "required": [
            "call_id",
            "output"
          ]
        }
      }
    ]
  }
}
